  "providers": {
    "gmail": {
      "name": "Gmail",
      "domains": [
        "gmail.com",
        "googlemail.com"
      ],
      "canonical_domain": "gmail.com",
      "rules": {
        "lowercase_local_part": true,
        "lowercase_local_part_confidence": "guaranteed",
        "subaddressing": {
          "separator": "+",
          "strip": true,
          "confidence": "guaranteed"
        },
        "dots": {
          "behavior": "ignore",
          "confidence": "guaranteed"
        },
        "canonical_domain": {
          "confidence": "guaranteed"
        }
      },
      "sources": [
        {
          "title": "Dots don't matter in Gmail addresses",
          "url": "https://support.google.com/mail/answer/7436150",
          "last_verified": "2026-10-21"
        },
        {
          "title": "Create task-specific email addresses",
          "url": "https://support.google.com/a/users/answer/9282734",
          "last_verified": "2026-10-21"
        }
      ],
      "notes": "gmail.com and googlemail.com are treated as the same Gmail provider and canonicalized to gmail.com."
    },
    "outlook": {
      "name": "Outlook.com",
      "domains": [
        "outlook.com"
      ],
      "rules": {
        "lowercase_local_part": true,
        "lowercase_local_part_confidence": "guaranteed",
        "subaddressing": {
          "separator": "+",
          "strip": true,
          "confidence": "guaranteed"
        },
        "dots": {
          "behavior": "significant",
          "confidence": "guaranteed"
        }
      },
      "sources": [
        {
          "title": "Add a +site address to your Outlook.com email",
          "url": "https://support.microsoft.com/en-us/office/add-a-site-address-to-your-outlook-com-email-cc3ed1f7-4223-4f21-8805-7f4c3f8f3f13",
          "last_verified": "2026-10-21"
        }
      ],
      "notes": "Only outlook.com is included for plus-address canonicalization. hotmail.com, live.com and msn.com are intentionally excluded until provider documentation is sufficiently explicit."
    },
    "proton": {
      "name": "Proton Mail",
      "domains": [
        "proton.me",
