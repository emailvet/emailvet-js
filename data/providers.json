          "last_verified": "2026-10-21"
        }
      ],
      "notes": "Plus aliases are canonicalized. Matching usernames across Proton-owned domains are not canonicalized because those relationships depend on account age, configuration or activation."
    },
    "yandex": {
      "name": "Yandex Mail",
      "domains": [
        "yandex.com"
      ],
      "rules": {
        "lowercase_local_part": true,
        "lowercase_local_part_confidence": "guaranteed",
        "subaddressing": {
          "separator": "+",
          "strip": false,
          "confidence": "observed"
        },
        "dots": {
          "behavior": "equivalent_to_hyphen",
          "confidence": "guaranteed"
        }
      },
      "conditional_equivalent_domains": [
        "ya.ru",
        "yandex.ru",
        "yandex.by",
        "yandex.kz"
      ],
      "sources": [
        {
          "title": "Why am I receiving someone else's email?",
          "url": "https://yandex.com/support/yandex-360/customers/mail/en/web/security/strange-letters",
          "last_verified": "2026-10-21"
        },
        {
          "title": "Additional email addresses",
          "url": "https://yandex.com/support/yandex-360/customers/mail/en/web/preferences/about-sender/additional-addresses",
          "last_verified": "2026-10-21"
        }
      ],
      "notes": "Dots and hyphens in Yandex usernames are documented as equivalent, so dots are canonicalized to hyphens. Country and short-domain aliases are not canonicalized because their availability can depend on the account."
    },
